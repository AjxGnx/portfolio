# Optional — copy to .env.local to enable Supabase-backed content, admin auth, and contact storage
# Without these vars, public pages use static mock data in src/data/mock.ts
# Get values from your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
